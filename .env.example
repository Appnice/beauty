# Self-hosting: cp .env.example .env && docker compose up -d  ->  http://localhost:8080
# Never commit .env. Change APP_SECRET and POSTGRES_PASSWORD before real use (long random strings,
# e.g. `openssl rand -hex 32`). Every other setting has a safe default in compose.yaml.

# Secret for signed links and code hashes.
APP_SECRET=zmien-mnie-na-dlugi-losowy-ciag
# Password of the bundled Postgres (no public port). Set it before the first start: Postgres keeps it.
POSTGRES_PASSWORD=zmien-mnie-tez
# Port on 127.0.0.1 and the address people open (used in SMS links).
PORT=8080
PUBLIC_URL=http://localhost:8080
# on = only one salon: the first "Załóż salon" creates it as active (no approval, no /admin), then sign-up closes.
SINGLE_SALON=on
# SMS: log (default, sends nothing, the code is in `docker compose logs app`) or smsapi (needs SMSAPI_TOKEN).
SMS_PROVIDER=log
SMSAPI_TOKEN=
SMSAPI_SENDER=
# on = show verification codes on screen (only for trying the app out).
SMS_ECHO=off
# Who runs this instance (the processor on the privacy page). Empty = "the operator of this server".
OPERATOR_NAME=
# Language of the screens until a visitor picks one with the PL / EN switch: pl or en. A salon created on an
# English page also sends its SMS messages in English.
DEFAULT_LANG=pl

# Domain with HTTPS (docker compose --profile domain up -d): set DOMAIN, PUBLIC_URL=https://<DOMAIN> and the
# two proxy lines, so the app sees the client IP and https.
DOMAIN=
# ADDRESS_HEADER=X-Forwarded-For
# PROTOCOL_HEADER=x-forwarded-proto

# Hosted instance only (deploy/compose.yml; tools/deploy.sh writes these from the Keychain, see docs/deploy.md):
# BEAUTY_DB_PASSWORD, ADMIN_PASSWORD, ADMIN_PHONE, ADMIN_NOTIFY_URL, SIGNUP_CODE, SEED_DEMO.

# Development (make dev / make check) reads .env.dev, not this file. Defaults need no file at all:
# DATABASE_URL=postgres://beauty:beauty@127.0.0.1:55440/beauty, PUBLIC_URL=http://localhost:8150.
