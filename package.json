{
  "name": "beauty",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Darmowy, otwarty system zapisów dla małych salonów",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite dev --port 8150 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 8150",
    "start": "node build",
    "prepare": "svelte-kit sync || echo ''",
    "migrate": "node scripts/migrate.ts",
    "seed": "node scripts/seed.ts",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "pg-boss": "12.38.0",
    "postgres": "4.1.1",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-node": "5.5.8",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
